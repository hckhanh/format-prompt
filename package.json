{
  "name": "format-prompt",
  "description": "A utility to format prompts for a cleaner presentation and optimal token usage",
  "version": "2.0.1",
  "author": {
    "name": "Khánh Hoàng",
    "email": "hi@khanh.id",
    "url": "https://www.khanh.id"
  },
  "homepage": "https://docs.khanh.id/format-prompt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hckhanh/format-prompt.git"
  },
  "bugs": {
    "url": "https://github.com/hckhanh/format-prompt/issues",
    "email": "hi@khanh.id"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
