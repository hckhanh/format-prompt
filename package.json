  "dependencies": {
    "string-collapse-leading-whitespace": "^7.1.0",
    "string-collapse-white-space": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "2.31.1",
    "@changesets/config": "3.1.4",
    "@codspeed/vitest-plugin": "6.1.0",
    "@toon-format/toon": "2.3.1",
    "@types/bun": "1.4.3",
    "@types/node": "25.9.9",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.42.1",
    "syncpack": "14.3.1",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "."
  ],
  "files": [
    "dist"
  ],
  "keywords": [
